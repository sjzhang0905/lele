+    source=tmp_path/'castep.cube';source.write_text(text.replace('Synthetic field\nOUTER','Synthetic field\ncastep2cube OUTER').replace('castep2cube OUTER LOOP: X, MIDDLE LOOP: Y, INNER LOOP: Z','castep2cube'))
